# Keepsong Environment Variables Example

# Database config
DATABASE_URL=postgresql://postgres:password@localhost:5432/keepsong

# Auth
JWT_SECRET=replace_with_a_secure_jwt_secret_key_32_characters_minimum

# Object Storage (S3 / Cloudflare R2)
OBJECT_STORAGE_ENDPOINT=https://your-r2-endpoint.cloudflare.com
OBJECT_STORAGE_BUCKET=keepsong-assets
OBJECT_STORAGE_ACCESS_KEY_ID=your_access_key_id
OBJECT_STORAGE_SECRET_ACCESS_KEY=your_secret_access_key

# Third-party APIs
ASR_API_KEY=your_asr_provider_api_key
NIM_API_KEY=your_nvidia_nim_api_key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
WEATHER_API_KEY=your_weather_api_key
